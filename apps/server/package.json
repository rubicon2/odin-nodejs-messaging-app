{
  "name": "@repo/server",
  "version": "1.0.0",
  "private": "true",
  "type": "module",
  "main": "./dist/index.mjs",
  "scripts": {
    "build": "pnpm clean && pnpm tsc",
    "build:watch": "pnpm clean && pnpm tsc --watch",
    "clean": "rm -rf dist/*",
    "dev": "pnpm run clean && npx tsc-watch --onSuccess \"node dist/index.mjs\"",
    "lint": "pnpm biome check",
    "lint:fix": "pnpm biome check --write",
    "test:unit": "pnpm vitest run --config vitest.unit.config.ts",
    "test:unit:watch": "pnpm vitest --config vitest.unit.config.ts"
  },
  "packageManager": "pnpm@10.30.3",
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@repo/vitest-config": "workspace:*",
    "@types/express": "^5.0.6",
    "jiti": "^2.7.0",
    "tsc-watch": "^7.2.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@repo/db": "workspace:*",
    "@repo/schemas": "workspace:*",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "zod": "^4.6.5"
  }
}
