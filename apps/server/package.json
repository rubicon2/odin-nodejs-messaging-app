{
  "name": "@repo/server",
  "version": "1.0.0",
  "private": "true",
  "type": "module",
  "main": "./dist/index.mjs",
  "scripts": {
    "build": "pnpm clean && pnpm exec tsc",
    "build:watch": "pnpm clean && pnpm exec tsc --watch",
    "clean": "rm -rf dist/*",
    "dev": "pnpm run clean && npx tsc-watch --onSuccess \"node dist/index.mjs\"",
    "lint": "pnpm exec eslint --fix"
  },
  "packageManager": "pnpm@10.30.3",
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/express": "^5.0.6",
    "tsc-watch": "^7.2.1",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "eslint": "^10.12.0",
    "jiti": "^2.7.0"
  },
  "dependencies": {
    "dotenv": "^18.0.5",
    "express": "^5.2.1"
  }
}
