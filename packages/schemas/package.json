{
  "name": "@repo/schemas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./*": {
      "types": "./src/*.mts",
      "default": "./dist/*.mjs"
    }
  },
  "scripts": {
    "build": "pnpm clean && pnpm exec tsc",
    "build:watch": "pnpm clean && pnpm exec tsc --watch",
    "clean": "rm -rf dist",
    "lint": "pnpm exec eslint --fix",
    "test:unit": "pnpm exec vitest --config vitest.unit.config.mts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.30.3",
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@repo/vitest-config": "workspace:*",
    "eslint": "^10.12.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "zod": "^4.6.5"
  }
}
