{
  "name": "@repo/schemas",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./*": {
      "types": "./src/*.mts",
      "default": "./dist/*.mjs"
    }
  },
  "scripts": {
    "build": "pnpm clean && pnpm tsc",
    "build:watch": "pnpm clean && pnpm tsc --watch",
    "clean": "rm -rf dist",
    "lint": "pnpm biome check",
    "lint:fix": "pnpm biome check --write",
    "test:unit": "pnpm vitest --config vitest.unit.config.mts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.30.3",
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@repo/vitest-config": "workspace:*",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "zod": "^4.6.5"
  }
}
