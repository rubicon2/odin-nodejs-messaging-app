{
  "name": "@repo/all-dates-to-iso-strings",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.mts",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "pnpm clean && pnpm tsc",
    "build:watch": "pnpm clean && pnpm tsc --watch",
    "clean": "rm -rf dist/*",
    "lint": "pnpm biome check",
    "lint:fix": "pnpm biome check --write",
    "test:unit": "pnpm vitest run --config vitest.unit.config.mts",
    "test:unit:watch": "pnpm vitest --config vitest.unit.config.mts"
  },
  "packageManager": "pnpm@10.30.3",
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@repo/vitest-config": "workspace:*",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
